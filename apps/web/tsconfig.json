{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the browser code, so it resolves imports, not Node.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
