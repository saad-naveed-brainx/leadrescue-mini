# Copy to .env. Placeholders and local-only values: never put real credentials here.

# Local Docker Postgres (see docker-compose.yml). Throwaway local-only credentials.
DATABASE_URL=postgres://leadrescue:leadrescue_local_only@localhost:55432/leadrescue
# Tests use this separate database; it is wiped and rebuilt on every `npm test`.
TEST_DATABASE_URL=postgres://leadrescue:leadrescue_local_only@localhost:55432/leadrescue_test

PORT=4000

# Database connections per process, and the background worker (npm run worker).
DB_POOL_SIZE=10
WORKER_CONCURRENCY=5
WORKER_POLL_MS=500
JOB_LEASE_SECONDS=60
