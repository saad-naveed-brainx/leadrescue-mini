# Copy to .env for local development. Placeholders only: never put real credentials here.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# Local Docker Postgres (see docker-compose.yml). Throwaway local-only credentials.
DATABASE_URL=postgres://leadrescue:leadrescue_local_only@localhost:55432/leadrescue
TEST_DATABASE_URL=postgres://leadrescue:leadrescue_local_only@localhost:55432/leadrescue_test

# Signs local login tokens. Any random string of 32+ characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_MODE=local
# The placeholder is deliberately too short: the server refuses to start until you replace it.
AUTH_JWT_SECRET=CHANGE_ME
